<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardBackgroundColor="@android:color/transparent"
    app:cardCornerRadius="24dp" app:cardElevation="0dp"
    app:strokeWidth="0dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackgroundBorderless">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ImageView
            android:id="@+id/iv_grid_cover"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:scaleType="centerCrop"
            android:background="?attr/colorSurfaceVariant"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintDimensionRatio="1:1" />

        <View
            android:id="@+id/v_scrim"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@drawable/scrim_gradient_vertical"
            app:layout_constraintTop_toTopOf="@id/iv_grid_cover"
            app:layout_constraintBottom_toBottomOf="@id/iv_grid_cover"
            app:layout_constraintStart_toStartOf="@id/iv_grid_cover"
            app:layout_constraintEnd_toEndOf="@id/iv_grid_cover" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp"
            app:layout_constraintBottom_toBottomOf="@id/iv_grid_cover"
            app:layout_constraintStart_toStartOf="@id/iv_grid_cover"
            app:layout_constraintEnd_toEndOf="@id/iv_grid_cover">

            <TextView
                android:id="@+id/tv_grid_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:fontFamily="sans-serif-black" android:textStyle="bold" android:textAppearance="?attr/textAppearanceTitleMedium" android:textColor="@android:color/white"
                tools:text="Название альбома" />

            <TextView
                android:id="@+id/tv_grid_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:fontFamily="sans-serif-medium"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="#D0D0D0" tools:text="Артист • 2024" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>