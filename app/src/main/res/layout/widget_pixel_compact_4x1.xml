<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_pixel_card_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="14dp"
    android:paddingTop="12dp"
    android:paddingEnd="14dp"
    android:paddingBottom="12dp">

    <!-- Left Section: Squircle Cover + Track Info (Clickable to open App) -->
    <LinearLayout
        android:id="@+id/widget_info_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Squircle Album Art / Note Tile -->
        <FrameLayout
            android:id="@+id/widget_art_container"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_gravity="center_vertical"
            android:background="@drawable/widget_pixel_art_bg"
            android:clipToOutline="true">

            <ImageView
                android:id="@+id/widget_album_art"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/album_cover"
                android:padding="13dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_pixel_music_note" />
        </FrameLayout>

        <!-- Metadata Column -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_track_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="marquee"
                android:fontFamily="sans-serif-medium"
                android:singleLine="true"
                android:text="PixelPlayer"
                android:textColor="@color/widget_pixel_on_surface"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="Alien Manifestation" />

            <TextView
                android:id="@+id/widget_track_artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif"
                android:singleLine="true"
                android:text="Tap to open"
                android:textColor="@color/widget_pixel_on_surface_variant"
                android:textSize="13sp"
                tools:text="Keiichi Okabe" />
        </LinearLayout>
    </LinearLayout>

    <!-- Right Section: 3 Squircle Control Buttons in a Row -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Previous Track Button -->
        <ImageButton
            android:id="@+id/widget_btn_prev"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/widget_pixel_tile_bg"
            android:contentDescription="@string/skip_previous"
            android:padding="11dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_skip_previous_filled"
            android:tint="@color/widget_pixel_on_surface" />

        <!-- Play / Pause Button -->
        <ImageButton
            android:id="@+id/widget_btn_play_pause"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/widget_pixel_tile_bg"
            android:contentDescription="@string/play"
            android:padding="11dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_play_arrow_filled"
            android:tint="@color/widget_pixel_on_surface" />

        <!-- Next Track Button -->
        <ImageButton
            android:id="@+id/widget_btn_next"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/widget_pixel_tile_bg"
            android:contentDescription="@string/skip_next"
            android:padding="11dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_skip_next_filled"
            android:tint="@color/widget_pixel_on_surface" />
    </LinearLayout>

</LinearLayout>
