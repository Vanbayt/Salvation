<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_pixel_card_bg"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Row 1: Album Art / Note & Play/Pause Button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <!-- Album Art / App Icon Tile -->
        <FrameLayout
            android:id="@+id/widget_art_container"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="6dp"
            android:layout_marginBottom="6dp"
            android:layout_weight="1"
            android:background="@drawable/widget_pixel_art_bg"
            android:clipToOutline="true">

            <ImageView
                android:id="@+id/widget_album_art"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/album_cover"
                android:padding="16dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_pixel_music_note" />
        </FrameLayout>

        <!-- Play / Pause Tile -->
        <ImageButton
            android:id="@+id/widget_btn_play_pause"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="6dp"
            android:layout_marginBottom="6dp"
            android:layout_weight="1"
            android:background="@drawable/widget_pixel_tile_bg"
            android:contentDescription="@string/play"
            android:padding="18dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_play_arrow_filled"
            android:tint="@color/widget_pixel_on_surface" />
    </LinearLayout>

    <!-- Row 2: Previous Track & Next Track -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <!-- Previous Track Button -->
        <ImageButton
            android:id="@+id/widget_btn_prev"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginTop="6dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/widget_pixel_tile_bg"
            android:contentDescription="@string/skip_previous"
            android:padding="18dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_skip_previous_filled"
            android:tint="@color/widget_pixel_on_surface" />

        <!-- Next Track Button -->
        <ImageButton
            android:id="@+id/widget_btn_next"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="6dp"
            android:layout_marginTop="6dp"
            android:layout_weight="1"
            android:background="@drawable/widget_pixel_tile_bg"
            android:contentDescription="@string/skip_next"
            android:padding="18dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_skip_next_filled"
            android:tint="@color/widget_pixel_on_surface" />
    </LinearLayout>

</LinearLayout>
