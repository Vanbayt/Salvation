<?xml version="1.0" encoding="utf-8"?>
<!-- Concept 5: Material Expressive Queue & Up Next Widget (4x3) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_queue_container_bg"
    android:orientation="vertical"
    android:padding="14dp"
    android:theme="@style/Theme.Gramophone">

    <!-- Top section: Current track elevated mini-player with squircle cover, title, artist, progress and controls -->
    <LinearLayout
        android:id="@+id/widget_current_track_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/widget_queue_current_card_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="10dp">

        <!-- Squircle Cover Art -->
        <ImageView
            android:id="@+id/widget_current_cover"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/widget_queue_thumb_bg"
            android:clipToOutline="true"
            android:contentDescription="@string/now_playing"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_default_cover"
            tools:src="@drawable/ic_default_cover" />

        <!-- Title, Artist & Expressive Progress Bar -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_current_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:singleLine="true"
                android:text="Starboy"
                android:textColor="@color/md_theme_onSurface"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:text="Starboy" />

            <TextView
                android:id="@+id/widget_current_artist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:singleLine="true"
                android:text="The Weeknd ft. Daft Punk"
                android:textColor="@color/md_theme_onSurfaceVariant"
                android:textSize="11.5sp"
                tools:text="The Weeknd ft. Daft Punk" />

            <!-- Sleek Material 3 Progress Bar with Scrub Dot Indicator -->
            <ProgressBar
                android:id="@+id/widget_progress_bar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:layout_marginTop="5dp"
                android:max="100"
                android:progress="58"
                android:progressDrawable="@drawable/widget_queue_progress"
                tools:progress="58" />

            <!-- Timestamps: 02:14 / 03:50 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/widget_current_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="02:14"
                    android:textColor="@color/md_theme_outline"
                    android:textSize="9.5sp"
                    tools:text="02:14" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/widget_total_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="03:50"
                    android:textColor="@color/md_theme_outline"
                    android:textSize="9.5sp"
                    tools:text="03:50" />
            </LinearLayout>
        </LinearLayout>

        <!-- Mini-Player Playback Controls -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/widget_btn_prev"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="@null"
                android:contentDescription="@string/play_next"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_skip_previous_filled"
                android:tint="@color/md_theme_onSurface" />

            <ImageButton
                android:id="@+id/widget_btn_play_pause"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/widget_queue_play_btn_bg"
                android:contentDescription="@string/now_playing"
                android:padding="7dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_pause_filled"
                android:tint="@color/md_theme_onPrimary" />

            <ImageButton
                android:id="@+id/widget_btn_next"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="@null"
                android:contentDescription="@string/play_next"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_skip_next_filled"
                android:tint="@color/md_theme_onSurface" />
        </LinearLayout>
    </LinearLayout>

    <!-- Queue Header: 'ДАЛЕЕ В ОЧЕРЕДИ' with badge '3 ТРЕКА' -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_queue_header_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.08"
            android:text="@string/widget_up_next"
            android:textAllCaps="true"
            android:textColor="@color/md_theme_outline"
            android:textSize="10.5sp"
            android:textStyle="bold"
            tools:text="ДАЛЕЕ В ОЧЕРЕДИ" />

        <TextView
            android:id="@+id/widget_queue_count_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/widget_queue_badge_bg"
            android:paddingStart="6dp"
            android:paddingTop="1.5dp"
            android:paddingEnd="6dp"
            android:paddingBottom="1.5dp"
            android:text="3 ТРЕКА"
            android:textColor="@color/md_theme_primary"
            android:textSize="9.5sp"
            android:textStyle="bold"
            tools:text="3 ТРЕКА" />
    </LinearLayout>

    <!-- Bottom section: Up Next queue rows (RemoteViews direct items) -->
    <LinearLayout
        android:id="@+id/widget_queue_items_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Track Row 1: 'Midnight City' (M83) - 04:03 -->
        <LinearLayout
            android:id="@+id/widget_queue_item_1"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/widget_queue_item_1_art"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/widget_queue_thumb_bg"
                android:clipToOutline="true"
                android:contentDescription="@null"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_default_cover"
                tools:src="@drawable/ic_default_cover" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_queue_item_1_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:text="Midnight City"
                    android:textColor="@color/md_theme_onSurface"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    tools:text="Midnight City" />

                <TextView
                    android:id="@+id/widget_queue_item_1_artist"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:text="M83 • Hurry Up, We're Dreaming"
                    android:textColor="@color/md_theme_onSurfaceVariant"
                    android:textSize="10sp"
                    tools:text="M83 • Hurry Up, We're Dreaming" />
            </LinearLayout>

            <TextView
                android:id="@+id/widget_queue_item_1_duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="04:03"
                android:textColor="@color/md_theme_outline"
                android:textSize="10.5sp"
                tools:text="04:03" />

            <ImageButton
                android:id="@+id/widget_queue_item_1_play"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:background="@drawable/widget_queue_icon_btn_bg"
                android:contentDescription="@string/widget_play_now"
                android:padding="5dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_play_arrow_filled"
                android:tint="@color/md_theme_primary" />
        </LinearLayout>

        <!-- Divider 1 -->
        <View
            android:id="@+id/widget_queue_divider_1"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginStart="42dp"
            android:alpha="0.35"
            android:background="@drawable/widget_queue_divider" />

        <!-- Track Row 2: 'Instant Crush' (Daft Punk) - 05:37 -->
        <LinearLayout
            android:id="@+id/widget_queue_item_2"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/widget_queue_item_2_art"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/widget_queue_thumb_bg"
                android:clipToOutline="true"
                android:contentDescription="@null"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_default_cover"
                tools:src="@drawable/ic_default_cover" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_queue_item_2_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:text="Instant Crush"
                    android:textColor="@color/md_theme_onSurface"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    tools:text="Instant Crush" />

                <TextView
                    android:id="@+id/widget_queue_item_2_artist"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:text="Daft Punk ft. Julian Casablancas"
                    android:textColor="@color/md_theme_onSurfaceVariant"
                    android:textSize="10sp"
                    tools:text="Daft Punk ft. Julian Casablancas" />
            </LinearLayout>

            <TextView
                android:id="@+id/widget_queue_item_2_duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="05:37"
                android:textColor="@color/md_theme_outline"
                android:textSize="10.5sp"
                tools:text="05:37" />

            <ImageButton
                android:id="@+id/widget_queue_item_2_play"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:background="@drawable/widget_queue_icon_btn_bg"
                android:contentDescription="@string/widget_play_now"
                android:padding="5dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_play_arrow_filled"
                android:tint="@color/md_theme_primary" />
        </LinearLayout>

        <!-- Divider 2 -->
        <View
            android:id="@+id/widget_queue_divider_2"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginStart="42dp"
            android:alpha="0.35"
            android:background="@drawable/widget_queue_divider" />

        <!-- Track Row 3: 'Nightcall' (Kavinsky) - 04:19 -->
        <LinearLayout
            android:id="@+id/widget_queue_item_3"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/widget_queue_item_3_art"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/widget_queue_thumb_bg"
                android:clipToOutline="true"
                android:contentDescription="@null"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_default_cover"
                tools:src="@drawable/ic_default_cover" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_queue_item_3_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:text="Nightcall"
                    android:textColor="@color/md_theme_onSurface"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    tools:text="Nightcall" />

                <TextView
                    android:id="@+id/widget_queue_item_3_artist"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:text="Kavinsky • Drive Original Soundtrack"
                    android:textColor="@color/md_theme_onSurfaceVariant"
                    android:textSize="10sp"
                    tools:text="Kavinsky • Drive Original Soundtrack" />
            </LinearLayout>

            <TextView
                android:id="@+id/widget_queue_item_3_duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="04:19"
                android:textColor="@color/md_theme_outline"
                android:textSize="10.5sp"
                tools:text="04:19" />

            <ImageButton
                android:id="@+id/widget_queue_item_3_play"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:background="@drawable/widget_queue_icon_btn_bg"
                android:contentDescription="@string/widget_play_now"
                android:padding="5dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_play_arrow_filled"
                android:tint="@color/md_theme_primary" />
        </LinearLayout>

        <!-- Optional ListView for dynamic RemoteViewsService adapter support -->
        <ListView
            android:id="@+id/widget_queue_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@drawable/widget_queue_divider"
            android:scrollbars="none"
            android:visibility="gone"
            tools:visibility="gone" />
    </LinearLayout>

    <!-- Footer / Action: Pill buttons to "Открыть очередь (14)" and "Перемешать" -->
    <LinearLayout
        android:id="@+id/widget_footer_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- "Открыть очередь (14)" (Open full queue) Pill Button -->
        <LinearLayout
            android:id="@+id/widget_btn_open_queue"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:background="@drawable/widget_queue_pill_btn_bg"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginEnd="6dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_playlist_play"
                android:tint="@color/md_theme_primary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:singleLine="true"
                android:text="@string/widget_open_queue"
                android:textColor="@color/md_theme_onSurface"
                android:textSize="11.5sp"
                android:textStyle="bold"
                tools:text="Открыть очередь (14)" />
        </LinearLayout>

        <View
            android:layout_width="8dp"
            android:layout_height="1dp" />

        <!-- "Перемешать" (Shuffle) Pill Button -->
        <LinearLayout
            android:id="@+id/widget_btn_shuffle"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:background="@drawable/widget_queue_pill_btn_bg"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="14dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginEnd="6dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_shuffle"
                android:tint="@color/md_theme_primary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:singleLine="true"
                android:text="@string/shuffle"
                android:textColor="@color/md_theme_onSurface"
                android:textSize="11.5sp"
                android:textStyle="bold"
                tools:text="Перемешать" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
