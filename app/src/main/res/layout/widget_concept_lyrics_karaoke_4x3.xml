<?xml version="1.0" encoding="utf-8"?>
<!--
    Concept 3: Material Expressive Karaoke & Synced Lyrics 2.0 Widget (4x3)
    100% RemoteViews-compatible for Android Home Screen AppWidget.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_concept_surface_32dp"
    android:orientation="vertical"
    android:padding="16dp"
    android:theme="@style/Theme.Gramophone"
    tools:layout_height="270dp"
    tools:layout_width="360dp">

    <!-- Top Header Bar: Squircle Art (18dp rx), Track Title, 24-96 Badge, Artist, and Mini Controls -->
    <RelativeLayout
        android:id="@+id/widget_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical">

        <!-- Mini Squircle Album Art -->
        <FrameLayout
            android:id="@+id/widget_album_art_container"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="@drawable/widget_squircle_mask_14dp"
            android:clipToOutline="true">

            <ImageView
                android:id="@+id/widget_album_art"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/album_cover"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_default_cover"
                tools:src="@drawable/ic_default_cover" />
        </FrameLayout>

        <!-- Metadata Container: Title + 24-96 Badge & Artist -->
        <LinearLayout
            android:id="@+id/widget_track_info_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_toStartOf="@+id/widget_playback_pill"
            android:layout_toEndOf="@id/widget_album_art_container"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingEnd="8dp">

            <!-- Title & 24-96 Badge Row -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/widget_track_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:text="Blinding Lights"
                    android:textColor="@color/md_theme_onSurface"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    tools:text="Blinding Lights" />

                <!-- 24-96 Hi-Res Badge -->
                <TextView
                    android:id="@+id/widget_track_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/widget_audio_badge_bg"
                    android:fontFamily="monospace"
                    android:paddingStart="5dp"
                    android:paddingTop="1dp"
                    android:paddingEnd="5dp"
                    android:paddingBottom="1dp"
                    android:text="24-96"
                    android:textColor="@color/md_theme_primary"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    tools:text="24-96" />
            </LinearLayout>

            <TextView
                android:id="@+id/widget_track_artist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif"
                android:maxLines="1"
                android:text="The Weeknd • After Hours"
                android:textColor="@color/md_theme_onSurfaceVariant"
                android:textSize="12sp"
                tools:text="The Weeknd • After Hours" />
        </LinearLayout>

        <!-- Mini Playback Control Pill (Play/Pause, Next) -->
        <LinearLayout
            android:id="@+id/widget_playback_pill"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/widget_playback_pill_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

            <ImageButton
                android:id="@+id/widget_btn_play_pause"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/play"
                android:padding="5dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_pause_filled" />

            <ImageButton
                android:id="@+id/widget_btn_next"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/skip_next"
                android:padding="5dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_skip_next_filled" />
        </LinearLayout>
    </RelativeLayout>

    <!-- Hairline Header Divider -->
    <View
        android:id="@+id/widget_header_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp"
        android:alpha="0.25"
        android:background="@color/md_theme_outlineVariant" />

    <!-- Main Body: Synchronized Lyrics Display (Karaoke 2.0) -->
    <LinearLayout
        android:id="@+id/widget_lyrics_body"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <!-- Line 1: Previous Line (Past, Muted) -->
        <LinearLayout
            android:id="@+id/widget_lyric_line_prev"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:alpha="0.55"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingVertical="2dp">

            <TextView
                android:id="@+id/widget_timestamp_prev"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_timestamp_badge_bg"
                android:fontFamily="sans-serif-medium"
                android:paddingStart="6dp"
                android:paddingTop="2dp"
                android:paddingEnd="6dp"
                android:paddingBottom="2dp"
                android:text="01:14"
                android:textColor="@color/md_theme_outline"
                android:textSize="10sp"
                tools:text="01:14" />

            <TextView
                android:id="@+id/widget_text_prev"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif"
                android:maxLines="1"
                android:text="I've been on my own for long enough"
                android:textColor="@color/md_theme_onSurfaceVariant"
                android:textSize="12.5sp"
                tools:text="I've been on my own for long enough" />
        </LinearLayout>

        <!-- Line 2: ACTIVE Karaoke Line in High-Contrast PrimaryContainer Pill (rx="28") -->
        <LinearLayout
            android:id="@+id/widget_lyric_active_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="4dp"
            android:background="@drawable/widget_lyric_active_pill_bg"
            android:orientation="vertical"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp">

            <!-- Active Header: Timestamp Badge & Animated Soundwave Bars -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/widget_timestamp_active"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/widget_timestamp_active_badge_bg"
                    android:fontFamily="sans-serif-medium"
                    android:paddingStart="7dp"
                    android:paddingTop="2dp"
                    android:paddingEnd="7dp"
                    android:paddingBottom="2dp"
                    android:text="01:22"
                    android:textColor="@color/md_theme_onPrimary"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    tools:text="01:22" />

                <!-- Animated Wave Bars Indicator -->
                <ImageView
                    android:id="@+id/widget_active_equalizer"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="8dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_widget_wave_bars"
                    android:tint="@color/md_theme_primary" />
            </LinearLayout>

            <!-- Active Karaoke Lyric Text (Bold with Word Highlight) -->
            <TextView
                android:id="@+id/widget_text_active"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:shadowColor="#80A2C9FE"
                android:shadowDx="0"
                android:shadowDy="0"
                android:shadowRadius="6"
                android:text="I said, ooh, I'm blinded by the lights"
                android:textColor="@color/md_theme_onPrimaryContainer"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:text="I said, ooh, I'm blinded by the lights" />

            <!-- Russian Translation Subtitle Line Beneath Active Line -->
            <TextView
                android:id="@+id/widget_translation_active"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:alpha="0.85"
                android:ellipsize="end"
                android:fontFamily="sans-serif"
                android:maxLines="1"
                android:text="RU «Я сказал: о, я ослеплен этим сиянием огней...»"
                android:textColor="@color/md_theme_onPrimaryContainer"
                android:textSize="11sp"
                tools:text="RU «Я сказал: о, я ослеплен этим сиянием огней...»" />
        </LinearLayout>

        <!-- Line 3: Upcoming Line +1 -->
        <LinearLayout
            android:id="@+id/widget_lyric_line_next1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:alpha="0.65"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingVertical="2dp">

            <TextView
                android:id="@+id/widget_timestamp_next1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_timestamp_badge_bg"
                android:fontFamily="sans-serif-medium"
                android:paddingStart="6dp"
                android:paddingTop="2dp"
                android:paddingEnd="6dp"
                android:paddingBottom="2dp"
                android:text="01:28"
                android:textColor="@color/md_theme_outline"
                android:textSize="10sp"
                tools:text="01:28" />

            <TextView
                android:id="@+id/widget_text_next1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif"
                android:maxLines="1"
                android:text="No, I can't sleep until I feel your touch"
                android:textColor="@color/md_theme_onSurfaceVariant"
                android:textSize="12.5sp"
                tools:text="No, I can't sleep until I feel your touch" />
        </LinearLayout>

        <!-- Line 4: Upcoming Line +2 (Subtle Tonal) -->
        <LinearLayout
            android:id="@+id/widget_lyric_line_next2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:alpha="0.35"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingVertical="2dp">

            <TextView
                android:id="@+id/widget_timestamp_next2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_timestamp_badge_bg"
                android:fontFamily="sans-serif-medium"
                android:paddingStart="6dp"
                android:paddingTop="2dp"
                android:paddingEnd="6dp"
                android:paddingBottom="2dp"
                android:text="01:35"
                android:textColor="@color/md_theme_outline"
                android:textSize="10sp"
                tools:text="01:35" />

            <TextView
                android:id="@+id/widget_text_next2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif"
                android:maxLines="1"
                android:text="I said, ooh, I'm drowning in the night"
                android:textColor="@color/md_theme_onSurfaceVariant"
                android:textSize="12.5sp"
                tools:text="I said, ooh, I'm drowning in the night" />
        </LinearLayout>
    </LinearLayout>

    <!-- Hairline Dock Divider -->
    <View
        android:id="@+id/widget_dock_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="6dp"
        android:alpha="0.20"
        android:background="@color/md_theme_outlineVariant" />

    <!-- Bottom Dock: 'KARAOKE SYNC 2.0' Pill with Green Pulse, 'EN ⇄ RU • ON' Pill, Scrubber Progress Bar -->
    <LinearLayout
        android:id="@+id/widget_bottom_dock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- KARAOKE SYNC 2.0 Pill with Green Pulse Dot -->
        <LinearLayout
            android:id="@+id/widget_pill_karaoke_sync"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:background="@drawable/widget_karaoke_sync_pill_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <!-- Green Pulse Dot -->
            <ImageView
                android:id="@+id/widget_pulse_dot"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:background="@drawable/widget_karaoke_pulse_dot"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/widget_karaoke_sync_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:fontFamily="sans-serif-medium"
                android:text="KARAOKE SYNC 2.0"
                android:textColor="@color/md_theme_primary"
                android:textSize="9sp"
                android:textStyle="bold"
                tools:text="KARAOKE SYNC 2.0" />
        </LinearLayout>

        <!-- EN ⇄ RU • ON Pill -->
        <LinearLayout
            android:id="@+id/widget_pill_translation"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/widget_chip_context_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <TextView
                android:id="@+id/widget_translation_toggle_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="EN ⇄ RU • ON"
                android:textColor="@color/md_theme_onSurfaceVariant"
                android:textSize="9sp"
                tools:text="EN ⇄ RU • ON" />
        </LinearLayout>

        <!-- Progress Scrubber Section: Current Time, Bar, Total Time -->
        <LinearLayout
            android:id="@+id/widget_scrubber_section"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_time_current"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="01:22"
                android:textColor="@color/md_theme_outline"
                android:textSize="9sp"
                tools:text="01:22" />

            <ProgressBar
                android:id="@+id/widget_playback_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="0dp"
                android:layout_height="4dp"
                android:layout_marginHorizontal="6dp"
                android:layout_weight="1"
                android:max="100"
                android:progress="42"
                android:progressBackgroundTint="@color/md_theme_surfaceContainerHighest"
                android:progressTint="@color/md_theme_primary" />

            <TextView
                android:id="@+id/widget_time_total"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="03:20"
                android:textColor="@color/md_theme_outline"
                android:textSize="9sp"
                tools:text="03:20" />
        </LinearLayout>
    </LinearLayout>

    <!-- Optional Adapter ListView for Scrolling RemoteCollectionItems Mode (default gone) -->
    <ListView
        android:id="@+id/widget_lyrics_list_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:divider="@null"
        android:scrollbars="none"
        android:visibility="gone" />

</LinearLayout>
